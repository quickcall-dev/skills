{
  "name": "plan-lifecycle-states",
  "title": "Plan lifecycle states",
  "subtitle": "Every run ends in exactly one terminal state. A repair never returns to a closed stage.",
  "width": 1300,
  "height": 600,
  "nodes": [
    {"id": "received", "x": 40, "y": 170, "width": 180, "height": 100, "title": "Received", "body": "Input pinned and hashed", "role": "input"},
    {"id": "scoped", "x": 280, "y": 170, "width": 180, "height": 100, "title": "Scoped", "body": "Policy compiled, budgets set", "role": "stage0"},
    {"id": "evidenced", "x": 520, "y": 170, "width": 180, "height": 100, "title": "Evidenced", "body": "Scene view cited", "role": "stage1"},
    {"id": "solved", "x": 760, "y": 170, "width": 180, "height": 100, "title": "Solved", "body": "Beats proven, chapters fit", "role": "stage2"},
    {"id": "verified", "x": 1000, "y": 170, "width": 190, "height": 100, "title": "Verified", "body": "All hard gates passed", "role": "success"},
    {"id": "invalid", "x": 280, "y": 420, "width": 180, "height": 100, "title": "Invalid input", "body": "Typed stop, not retryable", "role": "failure"},
    {"id": "unsolved", "x": 760, "y": 420, "width": 180, "height": 100, "title": "Unsolvable episode", "body": "Typed stop after bounded repair", "role": "failure"}
  ],
  "edges": [
    {"id": "s1", "from": "received", "to": "scoped"},
    {"id": "s2", "from": "scoped", "to": "evidenced"},
    {"id": "s3", "from": "evidenced", "to": "solved"},
    {"id": "s4", "from": "solved", "to": "verified", "colorRole": "success"},
    {"id": "s5", "from": "scoped", "to": "invalid", "fromPort": "bottom", "toPort": "top", "label": "cannot pin", "colorRole": "failure", "dashed": true},
    {"id": "s6", "from": "solved", "to": "unsolved", "fromPort": "bottom", "toPort": "top", "label": "repair exhausted", "colorRole": "failure", "dashed": true}
  ]
}
